- var baseSite = process.env.BASE_SITE || "https://intesa-vincente.on.shiper.app"

doctype html
html(lang="it")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    meta(name="description" content="WebApp del gioco Taboo.")
    meta(name="keywords" content="taboo,gioco,webapp")

    title Taboo
    link(rel="stylesheet" href="/css/main.css")

    link(rel="icon" href="/images/icons/icon-72x72.png" type="image/png")
    link(rel="manifest" href="/manifest.json")
    script(src="/service.js")

    script const GAME_ID = "#{gameID}";

  body.taboo
    header.flex.flex-col.gap-10.small
        a.button.pill.back(href="/")
          <ion-icon name="arrow-back-outline"></ion-icon>
        h1.title Taboo

    .flex-1.flex.flex-col.items-center
      #lobbyArea
        .flex.flex-col.items-center.gap-6.w-full.max-w-md.px-4
          h2.subtitle Unisciti alla partita
          
          .flex.flex-col.items-center.gap-4.w-full
            input#playerName.input-field.w-full(type="text" placeholder="Il tuo nome" autocomplete="off")
            
            .flex.gap-4.w-full
              button#teamA.button.pill.flex-1(disabled) Squadra Rossa
              button#teamB.button.pill.flex-1(disabled) Squadra Blu
            
            button#readyBtn.button.pill.w-full(disabled data-ready="false")
              <ion-icon name="checkmark-outline"></ion-icon>
              |  Pronto

          #lobbyInfo.mt-6
            h3.subtitle.text-lg Giocatori nella stanza
            #playersList.flex.flex-col.gap-2.mt-3

      #gameArea.hidden
        .flex.flex-col.items-center.gap-6.w-full.max-w-2xl.px-4
          .flex.gap-4.w-full.justify-center
            .team-box.team-rossa
              h3 Squadra Rossa
              .score#teamRossaScore 0
            .team-box.team-blu
              h3 Squadra Blu
              .score#teamBluScore 0

          #timerDisplay.text-center
            h2.text-6xl.font-bold#time 120
            p.text-lg#currentTurn Turno Squadra Rossa

          #roundInfo.text-gray-600 Round 1 di 4

          #roleIndicator.text-xl.mt-4

          #wordArea.text-center.mt-6.w-full.max-w-full.min-w-0
            h2.word-display.font-bold.uppercase#word
              span#wordText ??????
            
            .taboo-list.mt-6.w-full.max-w-full.min-w-0
              h3.subtitle Parole Taboo
              .taboo-words.flex.flex-wrap.gap-2.justify-center.mt-2.w-full.max-w-full
                each _, i in Array(5)
                  span.taboo-word(id="taboo" + i) --------

          #controlsArea.mt-8.w-full.max-w-full

      #victoryArea.hidden
        .flex.flex-col.items-center.gap-6.w-full.max-w-md.px-4
          header.flex.flex-col.gap-6.small
            .flex.items-center.justify-between.w-full
              #victoryTitle
                h1.title Vittoria!

          .flex-1.flex.flex-col.items-center
            #victoryAreaContent
              .winner-animation
                h2.subtitle.text-5xl.font-bold.mt-8
                  |  Partita Completata!
                
              .score-display.flex.flex-col.gap-6.mt-8
                .team-score.team-rossa
                  h3.text-2xl.font-bold Squadra Rossa
                  p.score#victoryRossaScore.text-4xl.font-bold.text-red-500 0
                .team-score.team-blu
                  h3.text-2xl.font-bold Squadra Blu
                  p.score#victoryBluScore.text-4xl.font-bold.text-blue-500 0
                
              .winner-text.mt-6
                h1.text-6xl.font-bold
                  #winnerText
                    |  Vittoria!
              
              .btn-container.mt-8
                button#restartBtn.button.pill.text-xl.w-full
                  <ion-icon name="refresh-outline"></ion-icon> Nuova Partita

    .mt-16.flex-1.flex.flex-col.items-center
      footer.mt-16.text-left.box
        h2.subtitle 📢 Condividi il link!
        .flex.items-center.gap-2.justify-center
          img.qrcode(src="https://api.qrserver.com/v1/create-qr-code/?ecc=M&margin=10&data=" + baseSite + "/taboo/" + gameID, alt=gameID)
        p.mt-4.flex.justify-center
          a.link.font-bold(href="/taboo/" + gameID) Clicca qui per aprire in un altro dispositivo

    script(src="/socket.io/socket.io.min.js")
    script(src="/js/taboo.js")

    script(type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js")
    script(nomodule, src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js")
